# Local Legal AI Configuration
DEFAULT_MODEL=Qwen/Qwen2.5-1.5B-Instruct
OPTIONAL_MODEL=Qwen/Qwen2.5-3B-Instruct
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DEVICE=cuda
LOAD_IN_4BIT=True
STREAMLIT_SERVER_PORT=8501

# Cloud Fallback Configuration (Google Gemini / Groq Cloud)
FALLBACK_ENABLED=True
FALLBACK_API_KEY=your_gemini_or_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_DEFAULT_MODEL=gemini-3.5-flash
GROQ_API_KEY=gsk_your_groq_key_here
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile
FALLBACK_CONFIDENCE_THRESHOLD=0.35
